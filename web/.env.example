# Copy to .env and fill in your own values. Never commit the real .env.
# AWS credentials are NOT set here — they come from your AWS CLI login / profile.

# --- Offline demo mode (no AWS needed) ---
# Set to 1 to answer from web/demo_responses.json with zero AWS calls.
BULLBOT_DEMO_MODE=0

# --- Live mode (Amazon Bedrock) ---
# Only needed when BULLBOT_DEMO_MODE is 0. Use your own resource IDs.
BULLBOT_KB_ID=your-kb-id
BULLBOT_GUARDRAIL_ID=your-guardrail-id
BULLBOT_GUARDRAIL_VERSION=1
AWS_REGION=us-east-1
